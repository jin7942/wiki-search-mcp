# Clean Ubuntu 컨테이너에서 wiki-search-mcp의 zero-config 진입을 검증.
#
# 빌드 (프로젝트 루트에서):
#   docker build -t wsm-user-test -f tests/integration/Dockerfile.user-test .
#
# 실행:
#   docker run --rm wsm-user-test
#
# 옵션 (HuggingFace 모델 캐시 마운트로 다운로드 회피):
#   docker run --rm -v ~/.cache/huggingface:/root/.cache/huggingface wsm-user-test

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# 시스템 의존성: Python, venv, pip, 빌드 도구는 일부 dependency 휠이 없을 때 필요
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        ca-certificates \
        bash \
        git \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# 프로젝트 복사 (호스트의 모든 파일을 /workspace로)
WORKDIR /workspace
COPY . /workspace

# 시나리오 스크립트 실행 권한
RUN chmod +x /workspace/tests/integration/run_user_scenarios.sh

ENTRYPOINT ["bash", "/workspace/tests/integration/run_user_scenarios.sh"]
